# Isse copy karke `.env` banayein:
#   cp supabase/functions/.env.example supabase/functions/.env
#
# CASHFREE_APP_ID / CASHFREE_SECRET_KEY -> Cashfree dashboard -> Developers -> API Keys
# CASHFREE_ENV -> "sandbox" (testing) ya "production" (live)
# PROJECT_URL  -> aapka Supabase project URL, webhook/return URL banane ke liye
#
# Note: SUPABASE_URL aur SUPABASE_SERVICE_ROLE_KEY Edge Functions mein automatic
# available hoti hain — inhe yahan set karne ki zaroorat nahi.

CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox
PROJECT_URL=https://your-project-ref.supabase.co
