# Isse copy karke `.env` banayein aur apne project ke values daalein:
#   cp .env.example .env
#
# Dono values Supabase dashboard -> Project Settings -> API mein milti hain.
# Yeh publishable (anon) key hai — client app mein rehna safe hai, kyunki
# database ko RLS policies protect karti hain. Service role key yahan KABHI na daalein.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key_here
